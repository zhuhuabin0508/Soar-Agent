# ===== SOAR 平台环境变量示例 =====
#
# 使用方法：
#   1. 复制本文件为 .env：cp .env.example .env
#   2. 按需修改各项值（尤其是生产环境必须修改 JWT_SECRET 和数据库密码）
#   3. docker compose 会自动读取项目根目录的 .env 文件进行变量插值
#
# 安全提示：
#   - .env 文件已在 .gitignore 中，不会被提交，请勿将真实凭证提交到版本库
#   - 生产环境务必使用强随机值（可用 python -c "import secrets;print(secrets.token_urlsafe(32))"）
#   - 切勿使用下方默认值部署生产环境

# ---------- PostgreSQL 数据库 ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres          # ⚠️ 生产环境必须修改
POSTGRES_DB=soar

# ---------- 鉴权与安全 ----------
# JWT 签名密钥：生产环境必须注入强随机值（>=32 字节）
# 生成命令：python -c "import secrets;print(secrets.token_urlsafe(32))"
JWT_SECRET=soar-dev-secret-change-me-in-production-please

# JWT 访问令牌有效期（分钟），默认 1440（24 小时）
# JWT_EXPIRE_MINUTES=1440

# ---------- 初始管理员（首次启动 seed 时创建）----------
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123        # ⚠️ 生产环境必须修改

# ---------- CORS 允许的源（逗号分隔）----------
# CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# ---------- LLM API Key（可选，留空走 Mock 降级）----------
# LLM 的 API Key 在系统「模型设置」页面配置，存储于数据库，无需在此填写
# ANTHROPIC_API_KEY=

# ---------- 连接串（通常无需修改，自动使用上面的数据库配置）----------
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/soar
# REDIS_URL=redis://redis:6379/0
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/1
