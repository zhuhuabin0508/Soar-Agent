# ===== 环境配置与密钥（严禁提交） =====
.env
.env.*
!.env.example
backend/.env
*.pem
*.key
*.crt
# TLS 证书/私钥一律不入库（生产证书放服务器固定路径 /etc/nginx/ssl/，见 deploy/nginx.conf）
# 注意：frontend/certs/server.{key,crt}、mkcert-CA.crt 已在 git 历史中被跟踪，
# 需手动 git rm --cached 从跟踪中移除（本 .gitignore 仅阻止今后的新增跟踪）。

# ===== 敏感数据 =====
# 真实弱密码清单等业务数据不入库
*.xlsx

# ===== 依赖与构建产物 =====
node_modules/
frontend/dist/
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# ===== 安全工具二进制（1.3GB，按需单独下载） =====
security-tools/

# ===== 历史压缩包与日志 =====
*.tar.gz
*.log

# ===== 编辑器与系统 =====
.vscode/
.idea/
.DS_Store
*.swp
*.tar
*.tar.gz
node_modules/
__pycache__/
*.pyc
.env
